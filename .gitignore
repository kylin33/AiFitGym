# ============================================================
# 构建产物
# ============================================================
# 注意：不要写成 /build —— 那样只忽略根目录，app/build 会漏进来（约 150 MB）
build/
.gradle/
.kotlin/
captures/
.cxx/
.externalNativeBuild/

# 编译中间件零星散落在模块根目录时（AGP 偶尔输出到这里）
*.apk
*.aab
*.ap_
*.dex
output.json

# JVM 崩溃日志
hs_err_pid*.log
replay_pid*.log
*.hprof

# ============================================================
# 本机专属配置（每台机器路径不同，或含私密信息）
# ============================================================
local.properties

# 签名材料绝不入库
*.jks
*.keystore
keystore.properties
signing.properties
signingConfig.properties

# ============================================================
# IDE / 编辑器
# ============================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
.navigation/
.fleet/

# ============================================================
# 系统垃圾
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 项目工具链
# ============================================================
# tools/ 下的 Python 脚本要入库，但它们跑出来的缓存不要
__pycache__/
*.py[cod]

# tag_exercises.py 每次写盘前留的原始数据备份（1.8 MB，可由上游重新生成）
tools/exercises.json.bak

# 脚本产出的校验截图 / 预览图，重跑即可再生成
tools/preview/

# AI 助手的工作目录（含上下文记录），属于本机工具状态
.workbuddy/

# ============================================================
# 明确「要提交」的东西（写在这里防止被上面的通配误伤）
# ============================================================
# gradle/wrapper/gradle-wrapper.jar  —— 必须入库，否则 clone 后跑不了 ./gradlew
# gradlew、gradlew.bat               —— 同上
# app/schemas/                       —— Room 导出的建表快照，用来校验迁移，必须入库
# app/src/main/assets/               —— 2303 个动作的 json + 动图 + 解剖数据，是打包内容不是产物
