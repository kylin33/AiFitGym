<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 跟练计时：前台服务让休息倒计时在锁屏/切后台时不被回收，
         WAKE_LOCK 保证息屏后 CPU 不被挂起（否则提示音会迟到） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 倒计时最后三秒与组间切换的触感反馈，适合手机放地上/口袋里的场景 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- AI 教练：请求用户自己配置的 OpenAI 兼容端点（官方 API / 中转站 / 本地 Ollama） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FitGymApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitGym">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.FitGym"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            specialUse 而不是 health：这里只是自己数秒，不读任何传感器，
            走 health 反而要额外的健康数据权限说明。
            stopWithTask=true：从最近任务划掉 App 时状态机已随 ViewModel 销毁，通知不该还在倒数。
        -->
        <service
            android:name=".service.WorkoutTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Active workout interval timer and rest countdown" />
        </service>
    </application>

</manifest>
